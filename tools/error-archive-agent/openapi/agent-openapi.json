          "capture",
          "solutions"
        ]
      }
    },
    "securitySchemes": {
      "AgentToken": {
        "type": "http",
        "description": "연결 토큰(`eaa_…`). `Authorization: Bearer eaa_…` 로 전송하면 게이트웨이가 introspection 으로 사용자·연결·scope(capture:read/write, artifact:write)로 해석한다. 웹 로그인 JWT 와 분리된다.",
        "scheme": "bearer",
        "bearerFormat": "opaque eaa_ token"
      }
    }
  }
