# ===================================================================
# noti-api · 로컬 환경 변수 템플릿
# ===================================================================
# 사용법:
#   1. `cp .env.example .env.local` 로 복사 (gitignored)
#   2. 아래 값을 본인 로컬에 맞게 채움
#   3. bootRun 전에 shell 에 export:
#        set -a; source .env.local; set +a
#      (또는 IntelliJ 의 EnvFile 플러그인 / IDE Run Config 의 env 변수)
#
# 주의: PRIVATE_KEY_PEM 같은 multi-line 값은 *그대로* 줄바꿈 보존된 채로 export 되어야
#       Spring 이 PEM 으로 파싱 가능. 평탄화하지 말 것.
# ===================================================================

# --- Kafka (noti-api docker-compose 가 띄운 broker) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# --- PostgreSQL (noti-postgres docker-compose) ---
NOTI_DB_URL=jdbc:postgresql://localhost:5434/noti_db
NOTI_DB_USERNAME=noti
NOTI_DB_PASSWORD=noti_local_pw

# --- SMTP (mailhog 기본) — 운영은 SES/SendGrid host/credential 로 교체 ---
NOTI_MAIL_HOST=localhost
NOTI_MAIL_PORT=1026
NOTI_MAIL_USERNAME=
NOTI_MAIL_PASSWORD=
NOTI_MAIL_SMTP_AUTH=false
NOTI_MAIL_STARTTLS=false

# --- Email / Push provider toggle ---
NOTI_EMAIL_PROVIDER=smtp
NOTI_EMAIL_FROM=notifications@error-archive.local
NOTI_EMAIL_FROM_NAME=Error Archive
NOTI_PUSH_ENABLED=false        # MVP1 deferred — true 로 켜면 FCM 파이프라인 활성
NOTI_PUSH_PROVIDER=logging
NOTI_FCM_PROJECT_ID=
NOTI_FCM_SERVICE_ACCOUNT_PATH=

# --- internal-auth issuer (noti-api 가 iam-api 호출 시 발급할 토큰의 서명 키) ---
# 실 PEM 블록을 줄바꿈 포함 그대로 붙여넣음.
NOTI_API_INTERNAL_AUTH_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----
<paste your local RSA private key here, preserve newlines>
-----END PRIVATE KEY-----"

# --- internal-auth verifier (gateway / core-api 가 보낸 토큰 검증용 public keys) ---
NOTI_API_VERIFIER_GATEWAY_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----
<paste gateway public key here>
-----END PUBLIC KEY-----"

NOTI_API_VERIFIER_CORE_API_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----
<paste core-api public key here>
-----END PUBLIC KEY-----"
