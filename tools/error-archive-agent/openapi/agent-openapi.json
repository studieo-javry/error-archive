              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAttemptRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "갱신됨",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AttemptResponse"
                }
              }
            }
          },
          "404": {
            "description": "없는 clientAttemptId / 없음·타인 소유 Capture (code=CAPTURE_NOT_FOUND)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "봉인 후 수정 시도 (code=CAPTURE_SEALED)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agent/me": {
      "get": {
        "tags": [
          "agent"
        ],
        "summary": "연결 확인(whoami)",
        "description": "\n            제시한 agent 토큰이 어떤 사용자·연결·범위로 해석되는지 반환한다. 커넥터의 설정/진단\n            (`doctor`)에서 토큰 유효성과 연결 상태를 확인하는 용도. 특정 scope 를 요구하지 않는다\n            (유효한 토큰이면 누구나). 폐기/만료 토큰은 게이트웨이에서 이미 401 로 차단된다.\n        ",
        "operationId": "me",
        "parameters": [
          {
            "name": "principal",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AgentPrincipal"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "유효 — principal 반환",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AgentIdentityResponse"
                }
              }
            }
          },
          "401": {
            "description": "토큰 없음/무효/폐기/만료"
          }
        }
      }
    },
    "/api/v1/agent/cases": {
      "get": {
        "tags": [
          "agent-case"
        ],
        "summary": "사례 검색",
        "description": "본인 소유 + 바인딩 귀속 케이스. projectBindingId 로 특정 바인딩만 필터.",
        "operationId": "search",
        "parameters": [
          {
            "name": "principal",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AgentPrincipal"
            }
          },
          {
            "name": "projectBindingId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AgentCaseListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agent/cases/{caseId}": {
      "get": {
        "tags": [
          "agent-case"
        ],
        "summary": "사례 상세",
        "description": "Step·Solution 포함. 본인 소유 + 바인딩 귀속만(아니면 404).",
        "operationId": "detail",
        "parameters": [
          {
            "name": "principal",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AgentPrincipal"
            }
          },
          {
            "name": "caseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AgentCaseDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "없음/허용 범위 밖"
          }
        }
      }
    }
  },
