    {
      "id": 5,
      "type": "logs",
      "title": "최근 ERROR · WARN",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 16
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "줄을 펼치면 traceId 옆 버튼으로 같은 요청의 추적(Tempo)으로 이동. 스택트레이스 뒷줄은 여기 안 나옴 — Explore 에서 앞뒤 줄 보기.",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{namespace=~\"apps|platform\", app=~\"$app\"} |~ `^\\S+ \\S+ (ERROR|WARN) `",
          "legendFormat": "",
          "editorMode": "code",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "showLabels": false,
        "prettifyLogMessage": false
      }
    }
  ]
}