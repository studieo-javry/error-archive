                "$ref": "#/components/schemas/PatchCaptureRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "수정됨",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CaptureResponse"
                }
              }
            }
          },
          "404": {
            "description": "없음/타인 소유 (code=CAPTURE_NOT_FOUND)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "revision 충돌 / 이미 봉인 (code=REVISION_CONFLICT·CAPTURE_SEALED)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agent/captures/{captureUuid}/solutions/{clientSolutionId}": {
