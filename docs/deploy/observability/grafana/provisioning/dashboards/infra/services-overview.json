          "refId": "A",
          "expr": "topk(10, sum by (application, method, uri) (rate(http_server_requests_seconds_sum{job=\"apps-jvm\", uri!~\"/internal/actuator.*\"}[$__range])) / sum by (application, method, uri) (rate(http_server_requests_seconds_count{job=\"apps-jvm\", uri!~\"/internal/actuator.*\"}[$__range])))",
          "legendFormat": "",
