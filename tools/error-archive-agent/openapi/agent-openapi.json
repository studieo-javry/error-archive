    "/api/v1/agent/captures/{captureUuid}/artifacts": {
      "post": {
        "tags": [
          "agent-capture"
        ],
        "summary": "근거 첨부 업로드(multipart)",
        "description": "\n            로컬 파일을 실제로 전송해 Capture 근거로 저장한다(로컬 경로 문자열만 보내는 것 금지).\n            허용: PNG/JPEG/WebP, UTF-8 텍스트·로그·diff, JSON. 파일당 10 MiB, Capture당 20개·총 50 MiB.\n            멱등: 같은 clientArtifactId·같은 내용은 기존 첨부 반환(200), 다른 내용은 409. OPEN 에서만.\n        ",
        "operationId": "uploadArtifact",
        "parameters": [
          {
            "name": "captureUuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "clientArtifactId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/AgentPrincipal"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "동일 첨부 재업로드(멱등)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactResponse"
                }
              }
            }
          },
          "201": {
            "description": "업로드됨",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactResponse"
                }
              }
            }
          },
          "404": {
            "description": "없음/타인 소유 (code=CAPTURE_NOT_FOUND)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "같은 clientArtifactId·다른 해시 / 봉인 (code=ARTIFACT_HASH_MISMATCH·CAPTURE_SEALED)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "파일/총량 한도 초과 (code=ARTIFACT_TOO_LARGE)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "허용되지 않은 형식(SVG/HTML/실행/압축) (code=UNSUPPORTED_ARTIFACT)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            }
          }
        }
      }
    },
