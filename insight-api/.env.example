# ===================================================================
# insight-api · 로컬 환경 변수 템플릿
# ===================================================================
# 사용법:
#   1. `cp .env.example .env.local` 로 복사 (gitignored)
#   2. 아래 값을 본인 로컬에 맞게 채움
#   3. bootRun 전에 shell 에 export:
#        set -a; source .env.local; set +a
#      (또는 IntelliJ 의 EnvFile 플러그인 / IDE Run Config 의 env 변수)
#
# 주의: PRIVATE_KEY_PEM 같은 multi-line 값은 *그대로* 줄바꿈 보존된 채로 export 되어야
#       Spring 이 PEM 으로 파싱 가능. 평탄화하지 말 것.
# ===================================================================

# --- Kafka (noti-api docker-compose 와 공유) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# --- PostgreSQL (insight-postgres docker-compose) ---
INSIGHT_DB_URL=jdbc:postgresql://localhost:5435/insight_db
INSIGHT_DB_USERNAME=insight
INSIGHT_DB_PASSWORD=insight_local_pw

# --- internal-auth issuer (insight-api 가 iam-api 호출 시 발급할 토큰의 서명 키) ---
# 실 PEM 블록을 *줄바꿈 포함* 그대로 붙여넣음.
INSIGHT_API_INTERNAL_AUTH_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----
<paste your local RSA private key here, preserve newlines>
-----END PRIVATE KEY-----"

# --- internal-auth verifier (gateway / core-api 가 보낸 토큰 검증용 public keys) ---
INSIGHT_API_VERIFIER_GATEWAY_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----
<paste gateway public key here>
-----END PUBLIC KEY-----"

INSIGHT_API_VERIFIER_CORE_API_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----
<paste core-api public key here>
-----END PUBLIC KEY-----"
