# ===================================================================
# gateway · 로컬 환경 변수 템플릿
# ===================================================================
# 사용법:
#   1. `cp .env.example .env.local` 로 복사 (gitignored)
#   2. 아래 값을 본인 로컬에 맞게 채움
#   3. bootRun 전에 shell 에 export:
#        set -a; source .env.local; set +a
#      (또는 IntelliJ 의 EnvFile 플러그인 / IDE Run Config 의 env 변수)
#
# 주의: PRIVATE_KEY_PEM 같은 multi-line 값은 줄바꿈 보존된 채로 export 되어야
#       Spring 이 PEM 으로 파싱 가능. 평탄화하지 말 것.
# ===================================================================

# --- JWT (사용자 access/sse 토큰 검증용) — iam-api 의 IAM_JWT_SECRET 과 동일해야 함 ---
IAM_JWT_SECRET=local-dev-secret-local-dev-secret-local-dev-secret-local-dev-secret-local-dev

# --- internal-auth issuer (gateway 가 downstream 으로 보낼 단명 JWT 의 서명 키) ---
# 실 PEM 블록을 줄바꿈 포함 그대로 붙여넣음.
GATEWAY_INTERNAL_AUTH_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----
<paste gateway local RSA private key here, preserve newlines>
-----END PRIVATE KEY-----"
