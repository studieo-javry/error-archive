          {
            "name": "principal",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AgentPrincipal"
            }
          },
          {
            "name": "captureUuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddSolutionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "추가/재생",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/SolutionResponse"
                }
              }
            }
          },
          "404": {
            "description": "없음/타인 소유 (code=CAPTURE_NOT_FOUND)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "중복 clientSolutionId / 봉인 (code=IDEMPOTENCY_CONFLICT·CONCURRENT_REQUEST·CAPTURE_SEALED)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "없는 Attempt 참조 / 참조 0개 / 미실행 PASSED·근거 없음 (code=UNKNOWN_ATTEMPT_REFERENCE·SOLUTION_WITHOUT_ATTEMPT·UNEXECUTED_VERIFICATION_PASSED·VERIFICATION_EVIDENCE_REQUIRED)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agent/captures/{captureUuid}/complete": {
      "post": {
