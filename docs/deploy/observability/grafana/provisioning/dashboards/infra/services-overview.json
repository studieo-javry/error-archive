      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{job=\"apps-jvm\", uri!~\"/internal/actuator.*\", status=~\"5..\"}[$__rate_interval])) / sum by (application) (rate(http_server_requests_seconds_count{job=\"apps-jvm\", uri!~\"/internal/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{application}}",
          "editorMode": "code",
          "instant": false,
          "range": true
