        "operationId": "complete",
        "parameters": [
          {
            "name": "principal",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AgentPrincipal"
            }
          },
          {
            "name": "captureUuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
