# ===================================================================
# publish-api · 환경 변수 템플릿
# ===================================================================
# 사용법:
#   1. `cp .env.example .env.local` 로 복사 (gitignored)
#   2. 아래 값을 로컬에 맞게 채움 — 특히 KEY_PEM 계열
#   3. bootRun 전에 export:
#        set -a; source .env.local; set +a
#      (또는 IntelliJ EnvFile 플러그인 / Run Config env)
#
# 환경별 파일(모두 gitignored): .env.local / .env.stg / .env.prod
#   - stg/prod 의 실제 시크릿은 이 파일들에 채워 k8s Secret 생성 소스로 사용.
#   - PRIVATE_KEY_PEM 같은 multi-line 값은 큰따옴표로 감싸 **줄바꿈 보존**한 채 export.
#       예) PUBLISH_INTERNAL_ISSUER_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
#           MIIE...
#           -----END PRIVATE KEY-----"
#
# 키 출처(운영): repo 밖 security/internal-keys/
#   - publish-api.key → PUBLISH_INTERNAL_ISSUER_PRIVATE_KEY  (publish 발행자 개인키)
#   - gateway.pub     → INTERNAL_AUTH_GATEWAY_PUBLIC_KEY      (gateway 공개키; 토큰 검증용)
#   - publish-api.pub → core-api 의 INTERNAL_AUTH_PUBLISH_API_PUBLIC_KEY 에 등록(짝)
# ===================================================================

# --- 로컬 실행 프로파일 (로컬만 지정; 미지정 시 base default=prod) ---
SPRING_PROFILES_ACTIVE=local

# --- Kafka (publish-api docker-compose broker) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# --- PostgreSQL (publish-postgres docker-compose, localhost:5436) ---
PUBLISH_DB_URL=jdbc:postgresql://localhost:5436/publish_db
PUBLISH_DB_USERNAME=publish
PUBLISH_DB_PASSWORD=publish_local_pw

# --- 다운스트림 / 공개 페이지 URL ---
PUBLISH_CORE_API_BASE_URL=http://localhost:8081
PUBLISH_PAGE_PUBLIC_BASE_URL=http://localhost:8000

# --- 첨부 presign (로컬 MinIO 기본; 운영은 OCI Object Storage) ---
PUBLISH_ATTACHMENT_BUCKET=error-archive-attachments
PUBLISH_ATTACHMENT_REGION=us-east-1
PUBLISH_ATTACHMENT_S3_ENDPOINT_PUBLIC=http://localhost:9000
PUBLISH_ATTACHMENT_S3_PATH_STYLE=true
PUBLISH_ATTACHMENT_S3_ACCESS_KEY=minioadmin
PUBLISH_ATTACHMENT_S3_SECRET_KEY=minioadmin
PUBLISH_ATTACHMENT_PRESIGN_TTL=30m

# --- 활동 이벤트 발행 모드 (kafka | noop) ---
NOTI_PUBLISHER_MODE=kafka

# --- 내부 인증 키 (여기 실키 넣지 말 것 — .env.local 에서 채움) ---
PUBLISH_INTERNAL_ISSUER_KEY_ID=publish-api-local-1
# 개인키 — 로컬 개발용 RSA 키를 생성하거나(local) 운영은 security/internal-keys/publish-api.key
PUBLISH_INTERNAL_ISSUER_PRIVATE_KEY=
# gateway 공개키(토큰 검증) — 로컬 gateway 키 / 운영은 security/internal-keys/gateway.pub
INTERNAL_AUTH_GATEWAY_PUBLIC_KEY=
