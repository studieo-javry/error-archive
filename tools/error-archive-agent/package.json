{
  "name": "@error-archive/agent",
  "version": "1.4.0",
  "description": "error-archive AI Agent Capture 커넥터 — Claude Code 등 로컬 AI 도구가 개발 중 오류·해결 과정을 비공개 초안으로 수집하는 MCP 서버.",
  "license": "UNLICENSED",
  "author": "error-archive",
  "homepage": "https://github.com/studieo-javry/error-archive/tree/alpha/tools/error-archive-agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/studieo-javry/error-archive.git",
    "directory": "tools/error-archive-agent"
  },
  "bugs": {
    "url": "https://github.com/studieo-javry/error-archive/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "error-archive",
    "ai-agent"
  ],
  "type": "module",
  "bin": {
    "error-archive-agent": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "tsx --test test-e2e/*.test.ts",
    "start": "node dist/index.js",
    "doctor": "tsx src/index.ts doctor",
    "dev": "tsx src/index.ts",
    "openapi:snapshot": "node scripts/fetch-openapi.mjs",
    "openapi:gen": "openapi-typescript openapi/agent-openapi.json -o src/generated/agent-api.ts",
    "openapi:check": "openapi-typescript openapi/agent-openapi.json -o src/generated/agent-api.ts && git diff --exit-code -- src/generated/agent-api.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
