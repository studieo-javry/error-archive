              "null"
            ]
          },
          "projectBindingId": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AgentCaseStepResponse"
            }
          },
          "solutions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AgentCaseSolutionResponse"
            }
          }
        },
        "required": [
