# ===================================================================
# iam-api · 로컬 환경 변수 템플릿
# ===================================================================
# 사용법:
#   1. `cp .env.example .env.local` 로 복사 (gitignored)
#   2. 아래 값을 본인 로컬에 맞게 채움
#   3. bootRun 전에 shell 에 export:
#        set -a; source .env.local; set +a
#      (또는 IntelliJ 의 EnvFile 플러그인 / IDE Run Config 의 env 변수)
# ===================================================================

# --- PostgreSQL (iam-postgres docker-compose) ---
IAM_DB_USERNAME=iam
IAM_DB_PASSWORD=iam_local_pw

# --- JWT (HS256) — ≥ 64자, 256bit 엔트로피 ---
IAM_JWT_SECRET=local-dev-secret-local-dev-secret-local-dev-secret-local-dev-secret-local-dev

# --- GitHub OAuth — https://github.com/settings/developers 에서 생성 ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- SMTP (MailHog 기본) — Gmail/SES/SendGrid 로 교체 가능 ---
IAM_MAIL_HOST=localhost
IAM_MAIL_PORT=1025
IAM_MAIL_USERNAME=
IAM_MAIL_PASSWORD=
IAM_MAIL_SMTP_AUTH=false
IAM_MAIL_STARTTLS=false
IAM_EMAIL_PROVIDER=smtp
IAM_EMAIL_FROM_ADDRESS=noreply@error-archive.local
IAM_EMAIL_FROM_NAME=Error Archive (local)

# --- Kafka (noti-api docker-compose 와 공유) — outbox relayer 가 발행 ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# --- Notification publisher mode ---
# kafka — outbox + relayer 로 user-activity.v1 발행 (운영 권장)
# http  — Noop fallback (잔디/알림 미발행, follow 동작은 정상)
NOTI_PUBLISHER_MODE=kafka
